# Bu dosyayı .env olarak kopyalayın ve doldurun. .env dosyasını asla paylaşmayın / git'e eklemeyin.

# --- bol.com Retailer API v10 (Partnerplatform > Instellingen > API-instellingen) ---
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

# --- Amazon SP-API (Seller Central > Apps & Services > Develop Apps) ---
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_SP_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_MARKETPLACE_ID=A1805IZSGTT6HS
# Amazon'un kendi (perakende) satıcı kimliğini biliyorsanız virgülle girin; boşsa "Amazon satıcı mı?" = bilinmiyor
AMAZON_RETAIL_SELLER_IDS=

# --- E-posta uyarıları (boşsa e-postalar data/outbox/ klasörüne .eml olarak yazılır) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# --- İsteğe bağlı ---
# NLF_DB_PATH=data/nlfirsat.db
